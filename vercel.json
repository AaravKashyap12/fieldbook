{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-wqHTteXnbpJmCfzOlC71C466CJflMM57HEEFXpo2MvE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self' https://github.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/skills/advise-project-approach/",
      "destination": "/skills/aaravkashyap12/advise-project-approach/",
      "permanent": true
    },
    {
      "source": "/skills/lean-engineering/",
      "destination": "/skills/aaravkashyap12/lean-engineering/",
      "permanent": true
    },
    {
      "source": "/skills/secure-launch/",
      "destination": "/skills/aaravkashyap12/secure-launch/",
      "permanent": true
    },
    {
      "source": "/skills/efficiency-skill/",
      "destination": "/skills/aaravkashyap12/efficiency-skill/",
      "permanent": true
    }
  ]
}
